# YES24 Open API 키 — developers.yes24.com 에서 발급 (이 앱 전용 계정, 가능하면 법인 회원)
# 서버에서만 쓴다. NEXT_PUBLIC_ 을 붙이지 말 것. 비우면 개발 중엔 샘플 모드, 운영에선 오류.
YES24_API_KEY=

# Mongo — 비워 두고 `npm run dev:mem` 을 쓰면 임시 Mongo 로 돈다. 배포는 bookbook, 개발 PC 는 bookbook_dev 를 권함
MONGODB_URI=
MONGODB_DB=bookbook

# 구글 로그인 — 추후 (지금은 일반 회원: 아이디·비밀번호) — Google Cloud 콘솔 > OAuth 클라이언트 ID(웹 애플리케이션)
# 승인된 리디렉션 URI: https://<배포 주소>/api/auth/google/callback (+ 내 PC 시험: http://localhost:7000/api/auth/google/callback)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# 앱 주소 (운영) — 구글 콘솔에 넣은 주소와 같아야 한다. 비우면 들어온 주소
APP_URL=

# 관리자(개발자) 계정 — 아이디 + 비밀번호(8자 이상, 직접 정해서). 이 아이디로 로그인하면 관리자 화면으로. 'fe'는 2글자라 일반 가입으론 못 만든다
ADMIN_ID=fe
ADMIN_PASSWORD=
# 관리자 (/admin) 더 — 아이디(ADMIN_HANDLES) 또는 구글 이메일, 쉼표로. 다 비우면 개발 중 시험 계정 '나'만
ADMIN_EMAILS=
ADMIN_HANDLES=
